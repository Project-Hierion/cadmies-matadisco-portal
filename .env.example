# Matadisco-CADMIES Portal — Environment Variables
# Copy this file to .env and fill in your values

# AT Protocol Authentication
MATADISCO_PDS_URL=https://pds.project-hierion.org
MATADISCO_HANDLE=gardener.pds.project-hierion.org
MATADISCO_APP_PASSWORD=your-app-password-here

# Portal Configuration
PORTAL_DEBUG=true
PORTAL_PORT=5000
